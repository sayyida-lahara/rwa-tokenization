# ==============================================================================
# AssetX: Solana Real World Asset (RWA) Tokenization Marketplace Environment
# ==============================================================================

# Application Meta
VITE_APP_NAME="AssetX"
VITE_APP_URL="http://localhost:5173"

# Solana Network Cluster: 'testnet' | 'devnet' | 'mainnet-beta' | 'localnet'
VITE_SOLANA_NETWORK="testnet"

# Solana RPC Endpoint URL
# Testnet: https://api.testnet.solana.com
# Devnet:  https://api.devnet.solana.com
# Mainnet: https://api.mainnet-beta.solana.com (or your private RPC e.g. Helius / QuickNode / Triton)
# Localnet: http://127.0.0.1:8899
VITE_SOLANA_RPC_ENDPOINT="https://api.testnet.solana.com"

# Solana Anchor Smart Contract Program ID
# Deployed Rust Anchor program address on Solana
VITE_SOLANA_PROGRAM_ID="AsstX11111111111111111111111111111111111111"

# SPL USDC Token Mint Addresses for Settlement
VITE_SPL_USDC_MINT_TESTNET="CpMah1WCS2zgGNfrnvPsqApdHcDqmDZTK5e2EHzNxChQ"
VITE_SPL_USDC_MINT_DEVNET="4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"
VITE_SPL_USDC_MINT_MAINNET="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"

# Block Explorers
VITE_SOLANA_EXPLORER_URL="https://explorer.solana.com"
VITE_SOLSCAN_URL="https://solscan.io"

# Protocol Features
VITE_ENABLE_ANCHOR_INSPECTOR="true"

# End-to-End Testing Target
BASE_URL="http://localhost:5173"
